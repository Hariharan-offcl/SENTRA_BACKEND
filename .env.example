# SENTRA Backend — environment reference (.env.example)
#
# Copy to .env and adjust. Every variable is optional; defaults shown are the
# code defaults. deploy/install.sh generates a real JWT secret for you.
#
# ── SECURITY-CRITICAL — set these in any real deployment ─────────────────────

# JWT signing secret. The shipped default is loudly flagged at startup.
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Login password. UNSET = any password logs in (bench mode, flagged at
# startup as NO_PASSWORD_CHECK). Set it to require a real password.
#SENTRA_PASSWORD=

# Rover pairing code the Pi displays (checked at /api/auth/rover/pair and
# /api/auth/rover/register). CHANGE the 123456 default in production.
SENTRA_PAIRING_CODE=123456

# ── Auth / CORS ───────────────────────────────────────────────────────────────

# false disables JWT enforcement on mutating REST + WS (dev only).
SENTRA_AUTH_ENFORCED=true
# Browser clients allowed by CORS (comma-separated). Non-browser clients
# (Flutter, curl) send no Origin and are unaffected. Default: allow all.
#SENTRA_CORS_ORIGINS=https://app.example.com

# ── Unit identity / network (config.py, pydantic settings) ───────────────────
#UNIT_ID=SNT-9042
#UNIT_NAME=SENTRA-Alpha
#HOST=0.0.0.0
#PORT=8080
#UDP_DISCOVERY_PORT=8888
#JWT_ALGORITHM=HS256
#JWT_EXPIRE_SECONDS=86400
#MAX_SPEED_MPS=1.2
#DEFAULT_SPEED_MULTIPLIER=0.5
#CAMERA_SNAPSHOT_DIR=~/sentra_snapshots

# ── Simulation / hardware mode ───────────────────────────────────────────────

# true = explicit simulation: fake sensors, GPIO/I2C init refused, motors
# force-stopped at startup (Phase 18). Leave unset on the real robot.
#SENTRA_SIMULATION=false

# Shared GPIO chip handle (Phase 2 consolidation — ONE handle for HAL +
# services). 0 and 4 are aliases of the same RP1 controller on Pi 5.
SENTRA_GPIOCHIP=0

# Motor pins (L298N). Change only if your wiring differs from the build doc.
#ENA/IN1/IN2=12/27/17   ENB/IN3/IN4=13/22/23  (module constants)

# ── Cliff sensors (pins NOT yet confirmed — placeholders) ────────────────────
SENTRA_CLIFF_ENABLED=true
SENTRA_CLIFF_LEFT_GPIO=19
SENTRA_CLIFF_RIGHT_GPIO=26
SENTRA_CLIFF_ACTIVE_HIGH=true

# ── Wheel encoders (pins NOT yet wired; GPIO 23 is RESERVED by IN4) ─────────
SENTRA_ENCODERS_ENABLED=true
SENTRA_ENCODER_LEFT_GPIO=20
SENTRA_ENCODER_RIGHT_GPIO=16
SENTRA_TICKS_PER_REV=20
SENTRA_WHEEL_DIAM_M=0.065

# ── Safety thresholds (core/config.py) ───────────────────────────────────────
SENTRA_FRONT_STOP_M=0.40
SENTRA_REAR_STOP_M=0.35
SENTRA_SPEED_MULT=0.5
SENTRA_CMD_TIMEOUT_S=0.6
SENTRA_AUTO_CMD_TIMEOUT_S=2.0
SENTRA_ACCEL_PCT_PER_S=150
SENTRA_DECEL_PCT_PER_S=300
SENTRA_BRAKE_HOLD_S=0.5
SENTRA_STALL_MA=2000
SENTRA_STALL_DWELL_S=0.2

# ── Patrol / docking / navigation ────────────────────────────────────────────
SENTRA_PATROL_CRUISE_DUTY=40
SENTRA_PATROL_WP_TIMEOUT_S=60
SENTRA_PATROL_ROUTES_PATH=~/sentra_data/patrol_routes.json
SENTRA_NAV_SEARCH_TIMEOUT_S=30
SENTRA_NAV_APPROACH_TIMEOUT_S=90
SENTRA_NAV_ARRIVE_M=0.45
SENTRA_ROUTE_GRAPH_PATH=~/sentra_data/route_graph.json
SENTRA_MAP_SNAPSHOT_DIR=~/sentra_data/maps

# ── Vision: AprilTag / camera geometry ───────────────────────────────────────
SENTRA_APRILTAG_ENABLED=true
SENTRA_APRILTAG_FAMILY=tag36h11
SENTRA_TAG_SIZE_M=0.06
SENTRA_CAM_HFOV_DEG=62.2
SENTRA_CAM_VFOV_DEG=48.8

# ── Person detection (Phase 6: HOG default via auto) ─────────────────────────
# auto = HOG when OpenCV is importable, else simulation. Watch avg_detect_ms
# in GET /api/v1/person/status and tune the HOG_* knobs for your Pi.
SENTRA_PERSON_ENABLED=true
SENTRA_PERSON_BACKEND=auto
SENTRA_PERSON_POLL_S=0.1
SENTRA_PERSON_MAX_AGE_S=1.5
SENTRA_PERSON_MIN_CONF=0.5
SENTRA_PERSON_EVENT_EVERY=3
SENTRA_PERSON_HOG_WIDTH=640
SENTRA_PERSON_HOG_WINSTRIDE=8
SENTRA_PERSON_HOG_SCALE=1.05

# ── Person recognition / registry ────────────────────────────────────────────
SENTRA_RECOG_ENABLED=true
SENTRA_RECOG_BACKEND=simple
SENTRA_RECOG_MATCH_THRESH=0.86
SENTRA_RECOG_POLL_S=0.2
SENTRA_RECOG_UNKNOWN_COOLDOWN_S=15
SENTRA_RECOG_SNAPSHOT_DIR=~/sentra_snapshots/persons
SENTRA_PERSON_REGISTRY_PATH=~/sentra_data/person_registry.json

# ── Fall detection / emergency call ─────────────────────────────────────────
SENTRA_FALL_ENABLED=true
SENTRA_FALL_POLL_S=0.25
SENTRA_FALL_MIN_CONF=0.5
SENTRA_FALL_ASPECT=1.15
SENTRA_FALL_CONFIRM_S=4.0
SENTRA_FALL_MOVEMENT_PX=8
SENTRA_EMERGENCY_ENABLED=true
SENTRA_EMERGENCY_RING_S=30
SENTRA_EMERGENCY_COOLDOWN_S=300

# ── Notifications / devices / stores ─────────────────────────────────────────
SENTRA_NOTIFICATIONS_ENABLED=true
SENTRA_NOTIFICATIONS_PATH=~/sentra_data/notifications.json
SENTRA_DEVICES_PATH=~/sentra_data/devices.json

# ── Cloud relay (optional remote access; disabled without a URL) ─────────────
#SENTRA_RELAY_URL=wss://relay.example.com/ws
#SENTRA_RELAY_UNIT_SECRET=change-me-if-using-relay
#SENTRA_RELAY_BODY_MAX=262144
#SENTRA_RELAY_RECONNECT_MAX_S=60
