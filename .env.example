# SENTRA Backend — Environment Variables
# Copy this file to .env and adjust for your Pi unit.

# Unit identity (override per robot)
UNIT_ID=SNT-9042
UNIT_NAME=SENTRA-Alpha
HARDWARE=Raspberry Pi 5 (8GB)
FIRMWARE_VERSION=v2.4.12-release
SERIAL_NUMBER=9042-88B

# Network
HOST=0.0.0.0
PORT=8080
UDP_DISCOVERY_PORT=8888

# JWT — CHANGE THIS SECRET IN PRODUCTION!
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=86400

# Camera
CAMERA_SNAPSHOT_DIR=/var/sentra/snapshots
MJPEG_QUALITY=80
MJPEG_FPS=30

# Motor
MAX_SPEED_MPS=1.2
DEFAULT_SPEED_MULTIPLIER=0.5

# IR sensor threshold
IR_THRESHOLD_LUX=10
