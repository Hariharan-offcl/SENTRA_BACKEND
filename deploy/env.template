# SENTRA Backend — environment template (Phase 19)
#
# Pi unit:  copy to /opt/sentra/.env  (systemd EnvironmentFile)
# Relay:    copy to /opt/sentra-relay/.env (SENTRA_RELAY_UNIT_SECRET only)
#
# The mode (REAL vs SIMULATION) is fixed at process start — set SENTRA_SIMULATION
# BEFORE first boot of the service.
#
# Naming conventions (both live in this file):
#   PLAIN names (PORT, JWT_SECRET_KEY, …) → config.py pydantic Settings fields
#   SENTRA_* names                        → os.getenv() in services/core modules

# ── Mode (Phase 18) ──────────────────────────────────────────────────────────
# true  → hardware refused (GPIO/I2C), preflight motor stop, loud banner
# false → real hardware (where present)
SENTRA_SIMULATION=false

# ── Auth (Phase 15) ──────────────────────────────────────────────────────────
# MUST be overridden in production — the shipped default is documented and
# therefore public. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<long-random-secret>   # feeds config.py Settings.jwt_secret_key
SENTRA_AUTH_ENFORCED=true
SENTRA_DEVICES_PATH=/home/sentra/sentra_data/devices.json

# ── Cloud relay (Phase 16) ───────────────────────────────────────────────────
# Empty → relay disabled (LAN-only unit). wss://… in production.
SENTRA_RELAY_URL=
SENTRA_RELAY_UNIT_SECRET=<relay-shared-secret>
SENTRA_RELAY_RECONNECT_MAX_S=30
SENTRA_RELAY_BODY_MAX=262144
SENTRA_UNIT_ID=SNT-9042

# ── Notifications (Phase 14) ─────────────────────────────────────────────────
SENTRA_NOTIFICATIONS_ENABLED=true
SENTRA_NOTIFICATIONS_PATH=/home/sentra/sentra_data/notifications.json

# ── Emergency auto-call (Phase 13) ───────────────────────────────────────────
SENTRA_EMERGENCY_ENABLED=true
SENTRA_EMERGENCY_RING_S=30
SENTRA_EMERGENCY_COOLDOWN_S=60

# ── Motion / safety tuning (Phases 1-3) ──────────────────────────────────────
SENTRA_FRONT_STOP_M=0.40
SENTRA_REAR_STOP_M=0.35
SENTRA_SPEED_MULT=0.5
SENTRA_CMD_TIMEOUT_S=0.6
SENTRA_AUTO_CMD_TIMEOUT_S=2.0
SENTRA_ACCEL_PCT_PER_S=150
SENTRA_DECEL_PCT_PER_S=300
SENTRA_BRAKE_HOLD_S=0.5

# ── Patrol / dock / nav tuning (Phases 7-9) ─────────────────────────────────
SENTRA_PATROL_OBSTACLE_M=1.0
SENTRA_PATROL_CRUISE_DUTY=40
SENTRA_PATROL_WP_TIMEOUT_S=60
SENTRA_PATROL_ROUTES_PATH=/home/sentra/sentra_data/patrol_routes.json
SENTRA_DOCK_SEARCH_TIMEOUT_S=25
SENTRA_DOCK_APPROACH_TIMEOUT_S=60
SENTRA_NAV_APPROACH_TIMEOUT_S=90

# ── Per-device enables (compose with SENTRA_SIMULATION; sim wins) ────────────
SENTRA_CLIFF_ENABLED=true
SENTRA_IMU_ENABLED=true
SENTRA_ENCODERS_ENABLED=true

# ── Identity / network (config.py; optional overrides) ───────────────────────
UNIT_NAME=SENTRA-Alpha
PORT=8080
UDP_DISCOVERY_PORT=8888   # plain names → config.py Settings (no prefix)
